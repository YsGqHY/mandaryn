<?xml version="1.0" encoding="utf-8"?>
<!--
  自定义字符串（简体中文）。

  只放我们自己定义的文案；WixUI 内置文案（!(loc.WixUIBack) 等）由
  WixToolset.UI.wixext 的 zh-cn 资源提供，构建时用 -culture zh-cn 引入。

  WiX v6 要求文案写在 Value 属性里，元素内文本已废弃（WIX0400）。

  **为什么当前只有中文 UI（待改双语，见 ROADMAP）**
  =========================================================
  `wix build` 一次只能产出**一种** culture；官方文档给出的多语言做法是用
  MSBuild 的 `.wixproj`（`<Cultures>en-US;zh-CN</Cultures>`）。本项目当前是
  Taskfile 驱动的 `wix build`，因此暂时只能单语。

  已实测的硬约束（勿再重复踩）：
  - 不能用 WIXUI_EXITDIALOGOPTIONALCHECKBOX 代替本卸载页 —— 官方文档明确写它
    "only shown during initial installation, not during maintenance mode or uninstall"。
  - `Package/@Language` 只接受单个整数，写 "1033;2052" 报 WIX0008。
  - 给 `-loc` 传两份 .wxl 报 WIX0100 标识符重复。
  - 多传 `-culture` 会让主语言变成第一项（实测变 1033 英文）且**丢失本文件的中文串**。

  改双语（.wixproj）在本机受阻：dotnet SDK 的 NuGet 组件损坏
  （任何 `dotnet restore` 都报 `Value cannot be null (path1)`，连 `dotnet` 的 `info`
  子命令都抛 TypeInitializationException），无法验证。需先修好 dotnet 环境再切。
-->
<WixLocalization Culture="zh-cn" Codepage="936" xmlns="http://wixtoolset.org/schemas/v4/wxl">

  <String Id="UninstOptTitle" Value="卸载选项" />
  <String Id="UninstOptDescription" Value="选择是否同时删除你的录音与设置" />
  <String Id="UninstOptCheckBox" Value="同时删除我的录音与设置（不可恢复）" />
  <String Id="UninstOptHint" Value="不勾选时将保留 %AppData%\Mandaryn 下的录音、转写结果与设置，重新安装后可以继续使用。" />

</WixLocalization>
