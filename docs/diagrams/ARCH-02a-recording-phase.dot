// ARCH-02a 运行时数据流 · 阶段一：录制（默认不跑推理）
// 来源：docs/ARCHITECTURE.md §1.2「阶段一：录制」（原 ASCII 流程图，FR-03-3/FR-03-6）
// 字体：Windows 用 "Microsoft YaHei"；Linux/macOS 改为 "Noto Sans CJK SC"
digraph ARCH_02a_recording_phase {
  graph [
    rankdir=TB,
    fontname="Microsoft YaHei", fontsize=14,
    nodesep=0.35, ranksep=0.40,
    bgcolor="white",
    labelloc="t", label="阶段一：录制（默认不跑推理）"
  ];
  node [
    shape=box, style="rounded,filled", fillcolor="#ffffff",
    color="#9aa0a6", fontcolor="#1f1f1f",
    fontname="Microsoft YaHei", fontsize=11, penwidth=1.1,
    margin="0.16,0.09"
  ];
  edge [
    color="#5f6368", penwidth=1.1, arrowsize=0.7,
    fontname="Microsoft YaHei", fontsize=9, fontcolor="#3c4043"
  ];

  app    [label="目标应用"];
  api    [label="平台捕获 API"];
  chan   [label="捕获通道(goroutine)"];
  resamp [label="重采样+混单声道"];
  ring   [label="16kHz/16bit PCM 环形缓冲"];

  wav    [label="音频落盘(WAV)"];
  stat   [label="电平/时长/字节统计"];

  wavp   [label="sessions/<id>/audio.wav"];
  evlvl  [label="EV: recording:level"];

  seal   [label="封存录音实例（封口 WAV + 写元数据）→ ST-05 → ST-06 completed", fillcolor="#eef7f0", color="#4a8a5c"];
  tstat  [label="transcription_status = none　←　「已保存 · 未转写」", fillcolor="#fff8e1", color="#c9a227"];

  app    -> api;
  api    -> chan;
  chan   -> resamp [label="32-bit float / 48kHz / 立体声（源格式）"];
  resamp -> ring;

  ring -> wav;
  ring -> stat;

  wav  -> wavp;
  stat -> evlvl;
  wavp -> seal;
  seal -> tstat;

  { rank=same; wav; stat; }
  { rank=same; wavp; evlvl; }
}
